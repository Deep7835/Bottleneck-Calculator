// Cloudflare Workers deployment: the repo root is the finished static site (generated by
// `node scripts/build.js` and committed), served as Workers static assets with no Worker code.
// .assetsignore keeps source, tooling and docs out of the upload.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "bottleneck-calculator",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
